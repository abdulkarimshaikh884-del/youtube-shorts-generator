{
  "name": "shortscraft",
  "version": "2.0.0",
  "description": "ShortsCraft animation template editor and creator community",
  "main": "server.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node generate-favicons.js",
    "test": "node verify_shell.js && node verify_editor.js && node verify_timeline.js && node verify_templates_v2.js && node verify_ai_definition.js && node verify_pages.js && node verify_mobile.js && node verify_auth.js && node verify_password_reset.js && node verify_export.js && node verify_credits.js && node verify_queue.js && node verify_social.js && node verify_projects.js && node verify_admin.js && node verify_support.js && node verify_skills.js && node audit_overlap.js && node verify_contrast.js --quick",
    "test:shell": "node verify_shell.js",
    "test:templates": "node verify_templates_v2.js",
    "test:export": "node verify_export.js",
    "test:editor": "node verify_editor.js",
    "test:timeline": "node verify_timeline.js",
    "test:pages": "node verify_pages.js",
    "test:mobile": "node verify_mobile.js",
    "test:credits": "node verify_credits.js",
    "test:ai": "node verify_ai_definition.js",
    "test:auth": "node verify_auth.js",
    "test:auth-reset": "node verify_password_reset.js",
    "test:legacy": "node verify_studio_redesign.js && node verify_generator_restore.js",
    "test:studio": "node verify_studio_redesign.js",
    "test:contrast": "node verify_contrast.js",
    "test:queue": "node verify_queue.js",
    "test:social": "node verify_social.js",
    "test:projects": "node verify_projects.js",
    "test:admin": "node verify_admin.js",
    "test:support": "node verify_support.js",
    "test:overlap": "node audit_overlap.js",
    "audit:css": "node audit_css_conflicts.js",
    "audit:site": "node audit_site.js",
    "test:skills": "node verify_skills.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "4.22.2",
    "pg": "^8.23.0",
    "puppeteer": "^25.3.0",
    "sharp": "0.35.4"
  },
  "overrides": {
    "body-parser": "1.20.6"
  }
}
