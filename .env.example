# ShortsCraft environment config
# Copy this file to ".env" and fill in real values. NEVER commit .env.

# ── Database (REQUIRED) ─────────────────────────────────────
# Accounts, sessions, credits, the waitlist, community templates and comments
# all live in Postgres. The app refuses to boot without this. See DEPLOY.md for
# how the least-privilege `shortscraft_app` role is created.
#
# USE THE POOLER HOST, NOT db.<ref>.supabase.co.
# Supabase's direct host (db.<project-ref>.supabase.co) publishes an AAAA
# record and no A record — it is reachable over IPv6 only. Any network without
# an IPv6 route (most Indian ISPs, most CI runners, Render's free tier) cannot
# open it at all, and the failure looks like an app bug rather than a network
# one: every query dies with "Connection terminated due to connection timeout"
# and the community gallery, credits and login all fail together.
#
# Supavisor, Supabase's pooler, answers on IPv4. Use the SESSION pooler
# (port 5432), not the transaction pooler: this is a long-lived backend, and
# session mode supports the prepared statements node-postgres uses.
#   postgresql://<role>.<project-ref>:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Three things that are easy to get wrong:
#   * the username carries the project ref after a dot, or the pooler answers
#     "tenant/user not found"
#   * the host prefix is aws-0 OR aws-1 depending on the project — check both
#   * the direct db.<ref>.supabase.co host is IPv6-only, which IPv4-only
#     platforms (Render, Vercel, GitHub Actions) cannot reach at all, and which
#     measured ~7x slower than the pooler from a home connection
#
# To check which one you have:  nslookup -type=A <host>
# No A record returned means IPv6-only and it will fail on an IPv4 network.
DATABASE_URL=postgresql://ROLE.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
# Bound database failures so pages show their fallback states instead of
# spinning forever. The defaults are safe for the cross-region pooler.
DB_CONNECTION_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=10000

# ── Password reset email (REQUIRED in production) ─────────
# PUBLIC_SITE_URL is used inside reset links. In production it must be HTTPS.
PUBLIC_SITE_URL=https://shortscraft.online
# Create the key at https://resend.com/api-keys after verifying your domain.
RESEND_API_KEY=
# The address must belong to a domain verified in Resend.
AUTH_FROM_EMAIL=ShortsCraft <account@shortscraft.online>

# ── AI generation (REQUIRED for /api/generate and /api/animate) ──
# At least ONE provider key must be set, or the SEO tools and AI animation
# return 503. Each provider is tried in turn with its own timeout, and one that
# fails is parked for five minutes so the next visitor is not made to wait on it.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Launch Boost pins the preferred model for predictable quality, then the server
# automatically rolls through floating/sibling Flash models during high demand.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODEL_FREE=gemini-3.5-flash-lite
GEMINI_MODEL_PRO=gemini-3.7-flash
GEMINI_MODEL_MAX=gemini-3.7-flash

# NVIDIA NIM — https://build.nvidia.com  (optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional per-tier overrides for the Pro / Pro Max model selectors
NVIDIA_MODEL_PRO=
NVIDIA_MODEL_MAX=

# Groq — https://console.groq.com/keys  (optional)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Temporary launch mode: Free gets the same strong planner as paid tiers. Set
# false after the initial launch window to restore the tier-specific models.
AI_LAUNCH_BOOST=true

# Which providers to try, in order. Defaults to "gemini,groq,nvidia". Anything
# without a key is skipped automatically, so this only matters when several are
# configured and you want a specific one to lead.
AI_PROVIDER_ORDER=gemini,groq,nvidia
# Per-provider timeout in ms (default 30000). The animation route uses a longer
# budget of its own, because a scene is a much heavier generation than a title.
AI_TIMEOUT_MS=30000

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=https://shortscraft.online,http://localhost:3000
# Signs the anonymous credit cookie. Production refuses to start without a
# random value of at least 32 characters. Never use the development fallback.
CREDITS_SECRET=
# Only for local test runs — never set this in production.
DISABLE_RATE_LIMIT=false
# Set when the host does not ship a bundled Chromium for the video exporter.
PUPPETEER_EXECUTABLE_PATH=

# ── Optional Supabase public configuration ──────────────────
# Support tickets, replies and account data all use DATABASE_URL.
# These REST keys are not required for the support ticket system.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Read by /api/config only; the app's own auth does not use them.
SUPABASE_ANON_KEY=

# ── Payments (Razorpay) — optional ──────────────────────────
# With both unset checkout is disabled and the Free plan remains available.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Plan prices are defined in credits.js; there is no separate price override.
# Shown on the pricing page while payments are not live yet, e.g. 2026-09-01
PAYMENTS_OPEN_DATE=

# ── Analytics — optional ────────────────────────────────────
GA_ID=
# Comma-separated owner accounts that should receive the solo Super Admin role.
SUPER_ADMIN_EMAILS=
